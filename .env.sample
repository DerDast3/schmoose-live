# Schmoose Live deployment configuration
# Copy this file to .env (same directory as docker-compose.yml) and fill in
# the values. See README.md.
#
# NOTE: never commit the real .env — it contains secrets.

# ── Required ─────────────────────────────────────────────────────────────
# HTTPS port for the web page + WebSocket (signaling).
PORT=9443

# Public hostname:port of THIS SFU, e.g. sfu.example.com:9443.
# Used for the WebSocket origin check. Must match the TLS certificate.
PUBLIC_HOST=sfu.example.com:9443

# Directory holding fullchain.pem + privkey.pem for PUBLIC_HOST.
# Mounted read-only into the container at /etc/sfu/certs.
CERT_DIR=./certs

# The address mediasoup announces to browsers for media (ICE). Leave empty
# to auto-detect: the first global IPv6 plus the first private IPv4 of the
# host. Set explicitly when the host sits behind 1:1 NAT.
RTC_ANNOUNCED_IP=

# UDP port range for media (ICE candidates). Must be open in your firewall.
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100

# ── Schmoose integration (ticket mode) ───────────────────────────────────
# standalone: the room ID itself is the ticket (testing without Schmoose).
# ticket:     rooms are entered via short-lived Ed25519 tickets minted by a
#             Schmoose server — the production mode.
AUTH_MODE=ticket

# Base URL of the Schmoose server (for fetching its public key).
# Public-key endpoint: {SCHMOOSE_URL}/api/rtc/public-key
SCHMOOSE_URL=https://schmoose.example.com:7443

# Shared secret with Schmoose (backend-to-backend room calls).
# Schmoose knows the same value as SFU_API_KEY. The SFU deliberately holds
# NO Schmoose-side key — the public-key fetch is unauthenticated.
API_KEY=change-me

# Alternative to API_KEY: read the key from a file (chmod 600), e.g. a
# mounted secret. Takes effect only when API_KEY is empty.
# If you use this, add your own bind mount for the file to the compose.
#API_KEY_FILE=

# ── Optional ─────────────────────────────────────────────────────────────
# none | error | warn | info | debug
LOG_LEVEL=info
